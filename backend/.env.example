# Server
NODE_ENV=development
PORT=3000

# Neon Postgres connection string
# Local:  postgresql://user:pass@localhost:5432/wizardchat
# Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@localhost:5432/wizardchat?sslmode=require

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Secrets — generate with: openssl rand -hex 32
# Required in production (>= 32 chars). Dev falls back to insecure defaults.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# AES-256 key for encrypting message content at rest (hex, 64 chars = 32 bytes)
# Generate with: openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=

# Cloudinary credential string from your Cloudinary dashboard — enables signed
# file uploads (attachments + avatars). Without it, /uploads/signature returns 503
# and the upload UI is disabled.
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Hosts allowed to serve attachment/avatar URLs. Enforced only when
# NODE_ENV=production. Comma-separated.
ALLOWED_ATTACHMENT_HOSTS=res.cloudinary.com

# Access token lifetime (seconds) and refresh session lifetime (days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Admin account seeded on deploy (idempotent — never overwrites an existing user)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
